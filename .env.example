# Environment variables for vikunja-mcp (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

TZ=US/Eastern
VIKUNJA_URL=http://vikunja:3456
VIKUNJA_TOKEN=
VIKUNJA_MCP_TRANSPORT=http
VIKUNJA_MCP_HOST=0.0.0.0
VIKUNJA_MCP_PORT=8000
